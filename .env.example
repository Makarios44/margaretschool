# Copie para .env (ou cadastre no painel da hospedagem) e preencha. Nunca versione o .env.

DJANGO_DEBUG=0
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=margaretschool.com.br,www.margaretschool.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://margaretschool.com.br,https://www.margaretschool.com.br

# PostgreSQL: postgres://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DATABASE_URL=postgres://margaret:troque-esta-senha@localhost:5432/margaret_school
# 1 se o banco exigir SSL (a maioria dos bancos gerenciados exige)
DB_SSL_REQUIRE=0
DB_CONN_MAX_AGE=60

# Pastas de uploads (opcional; padrão: media/ e midia_privada/ dentro do projeto). Faça backup das duas.
# DJANGO_MEDIA_ROOT=/srv/margaret/media
# DJANGO_MIDIA_PRIVADA=/srv/margaret/midia_privada

# 0 só se o proxy já redireciona HTTP -> HTTPS e o redirecionamento do Django causar loop
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# Dados da escola (também editáveis em Administração -> Dados da escola)
ESCOLA_NOME=Margaret School
ESCOLA_CNPJ=
ESCOLA_TELEFONE=(84) 99165-8059
